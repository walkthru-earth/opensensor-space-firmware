# pixi environments
.pixi/*
!.pixi/config.toml
backup/

# local agent / tooling state
# Agent git worktrees are created under .claude/worktrees, so ignore the lot.
.claude/
.code-review-graph/

# Firmware SDKs live in $OS_TOOLCHAIN_ROOT outside the repo, but ignore these
# defensively in case a tool ever writes one here.
.toolchains/

# Local secrets, the app signing key and its .env. Never commit them.
# tools/check_secrets.py fails lint if anything here is ever tracked.
# No trailing slash, so a secrets symlink or file is ignored too.
/secrets
# Environment files and key material anywhere in the tree.
.env
.env.*
*.pem
*.key
# Captures and exports at the repo root.
/artifacts/

# Host Python bytecode
__pycache__/
*.py[cod]
exports/
# Arduino upload can also create build caches under a sketch directory.
firmware/**/build/

# Native ESP-IDF generated files
**/managed_components/
**/sdkconfig.old
# The resolved sdkconfig belongs in the build directory, never beside a board.
firmware/**/sdkconfig
tools/fixtures/**/build/
firmware/common/logger/tests/compile/build/
tools/fixtures/**/dependencies.lock
firmware/common/logger/tests/compile/dependencies.lock

# Editor and OS state
.vscode/
.DS_Store
