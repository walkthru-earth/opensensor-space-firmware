        "opensensor:group": "particulate",
        "opensensor:scale": "who-2021-pm25",
        "firmware": {
          "type": "Float",
          "unit": "ug/m3",
          "validity": "sen6x_valid",
          "live_key": "m25",
          "decimals": 1
        }
      },
