        "name": "pm4_mass_ug_m3",
        "title": "PM4 mass concentration",
        "opensensor:title_i18n": {
          "ar": "تركيز كتلة الجسيمات PM4"
        },
        "unit": "ug/m3",
        "roles": [
          "physicalMeasurement"
        ],
        "opensensor:property": "urn:walkthru-earth:property:pm4_mass_concentration",
        "opensensor:valid_when": {
          "column": "sen6x_status",
          "equals": 4
        },
        "opensensor:settle_s": 30,
        "opensensor:aggregate": "mean",
        "opensensor:plausible_range": [
          0,
          1000
        ],
        "opensensor:group": "particulate",
        "firmware": {
          "type": "Float",
          "unit": "ug/m3",
          "validity": "sen6x_valid",
          "live_key": "m4",
          "decimals": 1
        }
      },
      {
        "name": "pm10_mass_ug_m3",
        "title": "PM10 mass concentration",
        "opensensor:title_i18n": {
          "ar": "تركيز كتلة الجسيمات PM10"
