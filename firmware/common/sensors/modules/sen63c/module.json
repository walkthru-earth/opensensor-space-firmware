{
  "type": "OpenSensorModule",
  "module_version": "0.1.0",
  "stac_opensensor": "0.1.0",
  "id": "sen63c",
  "procedure": "sen63c",
  "vendor": "Sensirion",
  "model": "SEN63C",
  "buses": [
    "i2c"
  ],
  "requires": {
    "i2c_address": [
      107
    ]
  },
  "status": {
    "column": "sen6x_status"
  },
  "segments": {
    "core": [
      {
        "name": "sen6x_status",
        "title": "Environmental sensor status",
        "opensensor:title_i18n": {
          "ar": "حالة المستشعر البيئي"
        },
        "unit": "{code}",
        "roles": [
          "qualityInformation"
        ],
        "classification:classes": [
          {
            "value": 0,
            "name": "missing",
            "nodata": true,
            "title": "Sensor missing"
          },
          {
            "value": 1,
            "name": "warming",
            "title": "Warming up"
          },
          {
            "value": 2,
            "name": "stale",
            "title": "No fresh reading"
          },
          {
            "value": 3,
            "name": "sensor-error",
            "title": "Sensor error"
          },
          {
            "value": 4,
            "name": "valid",
            "title": "Valid"
          }
        ],
        "opensensor:property": "urn:walkthru-earth:property:environmental_sensor_status",
        "opensensor:aggregate": "mode",
        "opensensor:group": "device",
        "firmware": {
          "type": "Int32",
          "unit": "code",
          "validity": "always",
          "live_key": "sen",
          "decimals": 0
        }
      },
      {
        "name": "sen6x_device_status",
        "title": "Environmental sensor status flags",
        "opensensor:title_i18n": {
          "ar": "أعلام حالة المستشعر البيئي"
        },
        "unit": "{bitmask}",
        "roles": [
          "qualityInformation"
        ],
        "opensensor:property": "urn:walkthru-earth:property:environmental_sensor_device_status_flags",
        "opensensor:valid_when": {
          "column": "sen6x_device_status",
          "finite": true
        },
        "opensensor:aggregate": "mode",
        "opensensor:group": "device",
        "classification:bitfields": [
          {
            "offset": 4,
            "length": 1,
            "name": "fan-error",
            "description": "Fan error",
            "classes": [
              {
                "value": 0,
                "name": "ok"
              },
              {
                "value": 1,
                "name": "set"
              }
            ]
          },
          {
            "offset": 6,
            "length": 1,
            "name": "rht-error",
            "description": "Humidity and temperature error",
            "classes": [
              {
                "value": 0,
                "name": "ok"
              },
              {
                "value": 1,
                "name": "set"
              }
            ]
          },
          {
            "offset": 11,
            "length": 1,
            "name": "pm-error",
            "description": "Particulate matter error",
            "classes": [
              {
                "value": 0,
                "name": "ok"
              },
              {
                "value": 1,
                "name": "set"
              }
            ]
          },
          {
            "offset": 12,
            "length": 1,
            "name": "co2-error",
            "description": "CO2 error",
            "classes": [
              {
                "value": 0,
                "name": "ok"
              },
              {
                "value": 1,
                "name": "set"
              }
            ]
          },
          {
            "offset": 21,
            "length": 1,
            "name": "fan-speed-warning",
            "description": "Fan speed out of range",
            "classes": [
              {
                "value": 0,
                "name": "ok"
              },
              {
                "value": 1,
                "name": "set"
              }
            ]
          }
        ],
        "firmware": {
          "type": "Int64",
          "unit": "bitmask",
          "validity": "sen6x_present",
          "live_key": "",
          "decimals": 0
        }
      },
      {
        "name": "pm1_mass_ug_m3",
        "title": "PM1 mass concentration",
        "opensensor:title_i18n": {
          "ar": "تركيز كتلة الجسيمات PM1"
        },
        "unit": "ug/m3",
        "roles": [
          "physicalMeasurement"
        ],
        "cf:standard_name": "mass_concentration_of_pm1_ambient_aerosol_particles_in_air",
        "opensensor:property": "http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_pm1_ambient_aerosol_particles_in_air/",
        "opensensor:valid_when": {
          "column": "sen6x_status",
          "equals": 4
        },
        "opensensor:settle_s": 30,
        "opensensor:aggregate": "mean",
        "opensensor:plausible_range": [
          0,
          1000
        ],
        "opensensor:group": "particulate",
        "firmware": {
          "type": "Float",
          "unit": "ug/m3",
          "validity": "sen6x_valid",
          "live_key": "m1",
          "decimals": 1
