{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/profile.json#",
  "title": "OpenSensor Thing Profile",
  "description": "Rules on top of STAC core and the OpenSensor extension for Thing Collections and file Items.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "Collection",
        "Feature"
      ]
    }
  },
  "if": {
    "properties": {
      "type": {
        "const": "Collection"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/thingCollection"
  },
  "else": {
    "$ref": "#/definitions/fileItem"
  },
  "definitions": {
    "thingCollection": {
      "type": "object",
      "required": [
        "type",
        "stac_extensions",
        "license",
        "keywords",
        "instruments",
        "opensensor:sample_interval_s",
        "opensensor:mobility",
        "partition:scheme",
        "partition:strategy",
        "partition:keys",
        "partition:glob",
        "providers",
        "item_assets",
        "links"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "stac_extensions": {
          "allOf": [
            {
              "$ref": "#/definitions/hasTable"
            },
            {
              "$ref": "#/definitions/hasOpenSensor"
            },
            {
              "$ref": "#/definitions/hasProfile"
            },
            {
              "$ref": "#/definitions/hasPartition"
            }
          ]
        },
        "keywords": {
          "type": "array",
          "minItems": 1
        },
        "instruments": {
          "type": "array",
          "minItems": 1
        },
        "partition:scheme": {
          "const": "hive"
        },
        "partition:strategy": {
          "const": "temporal"
        },
        "partition:keys": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "$ref": "#/definitions/partitionKey",
              "properties": {
                "name": {
                  "const": "year"
                }
              }
            },
            {
              "$ref": "#/definitions/partitionKey",
              "properties": {
                "name": {
                  "const": "month"
                }
              }
            },
            {
              "$ref": "#/definitions/partitionKey",
              "properties": {
                "name": {
                  "const": "day"
                }
              }
            }
          ]
        },
        "partition:glob": {
          "type": "string",
          "pattern": "/thing=[0-9a-f-]{36}/year=\\*/month=\\*/day=\\*/\\*\\.parquet$"
        },
        "providers": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "properties": {
                  "roles": {
                    "contains": {
                      "const": "producer"
                    }
                  }
                },
                "required": [
                  "roles"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "roles": {
                    "contains": {
                      "const": "host"
                    }
                  }
                },
                "required": [
                  "roles"
                ]
              }
            }
          ]
        },
        "item_assets": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/dataAsset"
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/catalogLink"
          },
          "contains": {
            "$ref": "#/definitions/dictionaryLink"
          }
        },
        "extent": {
          "type": "object",
          "required": [
            "temporal"
          ],
          "properties": {
            "temporal": {
              "type": "object",
              "required": [
                "interval"
              ],
              "properties": {
                "interval": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          },
          "$comment": "The temporal extent stays open, its end is null while the Thing publishes."
        }
      }
    },
    "fileItem": {
      "type": "object",
      "required": [
        "type",
        "stac_extensions",
        "collection",
        "geometry",
        "bbox",
        "properties",
        "links",
        "assets"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "stac_extensions": {
          "allOf": [
            {
              "$ref": "#/definitions/hasTable"
            },
            {
              "$ref": "#/definitions/hasOpenSensor"
            },
            {
              "$ref": "#/definitions/hasProfile"
            },
            {
              "contains": {
                "const": "https://stac-extensions.github.io/anonymized-location/v1.0.0/schema.json"
              }
            },
            {
              "contains": {
                "const": "https://stac-extensions.github.io/file/v2.1.0/schema.json"
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "required": [
            "datetime",
            "start_datetime",
            "end_datetime",
            "opensensor:mobility",
            "anon:size",
            "anon:warning"
          ],
          "properties": {
            "datetime": {
              "type": "null"
            },
            "grid:code": {
              "type": "string",
              "pattern": "^H3-88[0-9a-f]{13}$",
              "description": "An H3 cell at resolution 8, the only resolution a published Thing uses."
            },
            "anon:size": {
              "const": 0.01,
              "description": "Side of one resolution 8 cell in degrees, twice the mean H3 edge length over 111.32 km, rounded up to 3 decimals."
            }
          },
          "if": {
            "properties": {
              "opensensor:mobility": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "grid:code"
            ],
            "properties": {
              "anon:warning": {
                "const": "The geometry is the H3 cell chosen by the owner, not the device position."
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "grid:code"
              ]
            },
            "properties": {
              "anon:warning": {
                "const": "The geometry is the H3 cells the device visited, not its track."
              }
            }
          }
        },
        "assets": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "object",
              "required": [
                "href",
                "type",
                "roles",
                "table:row_count",
                "file:size",
                "file:checksum"
              ],
              "properties": {
                "href": {
                  "type": "string",
                  "pattern": "^\\./data_[0-9]{4}_[0-9a-f]{32}_[0-9]+-[0-9]+-[0-9]+\\.parquet$",
                  "description": "Relative to the Item, the Parquet file next to it."
                },
                "type": {
                  "const": "application/vnd.apache.parquet"
                },
                "roles": {
                  "type": "array",
                  "contains": {
                    "const": "data"
                  }
                },
                "file:size": {
                  "type": "integer",
                  "minimum": 1
                },
                "file:checksum": {
                  "$ref": "#/definitions/checksum"
                }
              }
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/catalogLink"
          }
        }
      },
      "if": {
        "properties": {
          "properties": {
            "properties": {
              "opensensor:mobility": {
                "const": "fixed"
              }
            },
            "required": [
              "opensensor:mobility"
            ]
          }
        },
        "required": [
          "properties"
        ]
      },
      "then": {
        "$comment": "A fixed Thing names its cell with the Grid extension.",
        "properties": {
          "stac_extensions": {
            "contains": {
              "const": "https://stac-extensions.github.io/grid/v1.1.0/schema.json"
            }
          }
        }
      },
      "else": {
        "$comment": "A moving Thing has no single cell, and the Grid extension requires grid:code, so it is not listed.",
        "properties": {
          "stac_extensions": {
            "not": {
              "contains": {
                "const": "https://stac-extensions.github.io/grid/v1.1.0/schema.json"
              }
            }
          }
        }
      }
    },
    "hasTable": {
      "contains": {
        "const": "https://stac-extensions.github.io/table/v1.3.0/schema.json"
      }
    },
    "hasOpenSensor": {
      "contains": {
        "const": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/schema.json"
      }
    },
    "hasProfile": {
      "contains": {
        "const": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/profile.json"
      }
    },
    "hasPartition": {
      "contains": {
        "const": "https://schemas.portolan-sdi.org/incubating/partition/v1.0.0/schema.json"
      }
    },
    "partitionKey": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "type": {
          "const": "int32"
        }
      }
    },
    "dictionaryLink": {
      "type": "object",
      "required": [
        "rel",
        "href",
        "type",
        "file:checksum"
      ],
      "properties": {
        "rel": {
          "const": "describedby"
        },
        "type": {
          "const": "text/plain"
        },
        "file:checksum": {
          "$ref": "#/definitions/checksum"
        }
      }
    },
    "dataAsset": {
      "$comment": "The data asset of a Thing. Also used by board templates.",
      "type": "object",
      "required": [
        "type",
        "roles",
        "table:primary_datetime",
        "table:columns"
      ],
      "properties": {
        "type": {
          "const": "application/vnd.apache.parquet"
        },
        "roles": {
          "type": "array",
          "contains": {
            "const": "data"
          }
        },
        "table:columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "physicalMeasurement",
              "auxiliaryInformation",
              "qualityInformation",
              "referenceInformation",
              "coordinate",
              "modelResult"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "physicalMeasurement"
                }
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "opensensor:property",
              "opensensor:procedure",
              "opensensor:field_id",
              "opensensor:aggregate",
              "opensensor:valid_when"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "enum": [
                    "auxiliaryInformation",
                    "qualityInformation"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "opensensor:procedure",
              "opensensor:field_id",
              "opensensor:aggregate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "modelResult"
                }
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "opensensor:derived",
              "opensensor:aggregate"
            ]
          }
        }
      ]
    },
    "checksum": {
      "type": "string",
      "pattern": "^1220[0-9a-f]{64}$"
    },
    "relativeHref": {
      "type": "string",
      "not": {
        "pattern": "^([a-zA-Z][a-zA-Z0-9+.-]*:|/)"
      },
      "$comment": "No scheme and no leading slash, so neither /catalog.json nor //host/catalog.json passes."
    },
    "catalogLink": {
      "$comment": "Links between catalog files are relative, so a copied or mirrored catalog keeps working.",
      "if": {
        "properties": {
          "rel": {
            "enum": [
              "root",
              "parent",
              "collection",
              "child",
              "item"
            ]
          }
        },
        "required": [
          "rel"
        ]
      },
      "then": {
        "properties": {
          "href": {
            "$ref": "#/definitions/relativeHref"
          }
        }
      }
    }
  }
}
