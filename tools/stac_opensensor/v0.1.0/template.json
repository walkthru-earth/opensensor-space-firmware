{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walkthru-earth.github.io/stac-opensensor/v0.1.0/template.json#",
  "title": "OpenSensor Board Template",
  "description": "What a firmware build knows about its columns, keyed by the dictionary digest. Not a STAC document.",
  "type": "object",
  "required": [
    "type",
    "template_version",
    "id",
    "instruments",
    "opensensor:sample_interval_s",
    "item_assets",
    "links",
    "firmware"
  ],
  "properties": {
    "type": {
      "const": "OpenSensorTemplate"
    },
    "template_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "opensensor:sample_interval_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "opensensor:primary": {
      "$ref": "schema.json#/definitions/fields/properties/opensensor:primary"
    },
    "opensensor:scales": {
      "$ref": "schema.json#/definitions/fields/properties/opensensor:scales"
    },
    "item_assets": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "allOf": [
            {
              "$ref": "profile.json#/definitions/dataAsset"
            },
            {
              "$ref": "schema.json#/definitions/tableHolder"
            }
          ]
        }
      }
    },
    "links": {
      "type": "array",
      "contains": {
        "$ref": "profile.json#/definitions/dictionaryLink"
      }
    },
    "firmware": {
      "type": "object",
      "required": [
        "schema",
        "proto_min",
        "dict",
        "live_keys"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "proto_min": {
          "type": "integer",
          "minimum": 1
        },
        "dict": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "live_keys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,15}$"
          }
        },
        "unit_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "setup": {
          "$comment": "Ordered setup wizard steps. The bits of GET_CONFIG thing.setup_ack follow this order, so 31 at most.",
          "type": "array",
          "maxItems": 31,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$comment": "bonds and sensor are Device settings sections only.",
                "allOf": [
                  {
                    "$ref": "#/definitions/stepId"
                  },
                  {
                    "not": {
                      "enum": [
                        "bonds",
                        "sensor"
                      ]
                    }
                  }
                ]
              },
              "req": {
                "type": "boolean"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "label_i18n": {
                "$ref": "schema.json#/definitions/i18n"
              },
              "keys": {
                "$ref": "#/definitions/stepKeys"
              }
            },
            "additionalProperties": false
          }
        },
        "settings": {
          "$comment": "Ordered Device settings sections. name and mobility are setup steps only.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "allOf": [
                  {
                    "$ref": "#/definitions/stepId"
                  },
                  {
                    "not": {
                      "enum": [
                        "name",
                        "mobility"
                      ]
                    }
                  }
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "label_i18n": {
                "$ref": "schema.json#/definitions/i18n"
              },
              "keys": {
                "$ref": "#/definitions/stepKeys"
              }
            },
            "additionalProperties": false
          }
        },
        "config_keys": {
          "$comment": "SET_CONFIG keys a generic step or section shows. Names and types only, never a value or a secret.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/configKey"
          },
          "additionalProperties": {
            "$ref": "#/definitions/configKeySpec"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "stepId": {
      "$comment": "A step from the app catalog or a board's own id. Find, Pair, Permission and Done are app owned.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "not": {
        "enum": [
          "find",
          "pair",
          "permission",
          "done"
        ]
      }
    },
    "stepKeys": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configKey"
      },
      "uniqueItems": true
    },
    "configKey": {
      "$comment": "A board key, two or more dot separated parts. The app owns every key under the reserved prefixes.",
      "type": "string",
      "maxLength": 48,
      "pattern": "^(?!(ble|wifi|lan|ntp|location|thing|owner|sensor)\\.)[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "configKeySpec": {
      "type": "object",
      "required": [
        "type",
        "applies",
        "page",
        "label"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "integer",
            "enum",
            "text"
          ]
        },
        "values": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number"
                ],
                "minLength": 1
              }
            },
            {
              "$ref": "#/definitions/range"
            }
          ]
        },
        "applies": {
          "enum": [
            "immediately",
            "next sample",
            "next boot",
            "action"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "label_i18n": {
          "$ref": "schema.json#/definitions/i18n"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "$ref": "#/definitions/range"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "allOf": [
                  {
                    "$ref": "#/definitions/range"
                  },
                  {
                    "properties": {
                      "min": {
                        "minimum": 0
                      },
                      "max": {
                        "maximum": 64
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applies": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
