# clangd settings for the firmware and the host tests. See the Editor setup
# section of docs/shared/development.md. Paths in If are relative to this
# file, and so is CompilationDatabase.
#
# The board compile databases are written by `pixi run cores3-build`,
# `pixi run waveshare-build logger` and `pixi run waveshare-build diagnostic`.
# Shared code under firmware/common is in no database of its own, so it
# borrows a board one. Its own sources are in that database, and headers take
# the command of a nearby source.

# The Waveshare V2 diagnostic image has its own build.
If:
  PathMatch: firmware/esp-idf-waveshare-sim7670g/diagnostic/.*
CompileFlags:
  CompilationDatabase: firmware/esp-idf-waveshare-sim7670g/build/diagnostic

---
# Other Waveshare V2 sources, and the GNSS reader only the Waveshare logger
# builds, use the Waveshare logger build.
If:
  PathMatch:
    - firmware/esp-idf-waveshare-sim7670g/.*
    - firmware/common/gnss_reader/.*
  PathExclude: firmware/esp-idf-waveshare-sim7670g/diagnostic/.*
CompileFlags:
  CompilationDatabase: firmware/esp-idf-waveshare-sim7670g/build/logger

---
# Everything else under firmware uses the CoreS3 build.
If:
  PathMatch: firmware/.*
  PathExclude:
    - firmware/esp-idf-waveshare-sim7670g/.*
    - firmware/common/gnss_reader/.*
CompileFlags:
  CompilationDatabase: firmware/esp-idf-cores3/build/bringup

---
# Both boards build with xtensa-esp32s3-elf-gcc. clang does not know its
# -m and -f options, so drop them as the ESP-IDF VS Code extension does, then
# add back the two that change what the code may use. The C++ dialect stays
# as the database has it, our sources end with -std=gnu++23 from
# os_pin_cxx_standard(). BuiltinHeaders reads the GCC headers through
# --query-driver, which ESP-IDF 6.1 toolchains need.
If:
  PathMatch: firmware/.*
CompileFlags:
  Remove: [-m*, -f*]
  Add: [-fno-exceptions, -fno-rtti]
  BuiltinHeaders: QueryDriver

---
# Host tests have no database. Each tools/test_*.py passes its own -I list to
# the host clang++, with the dialect from CXX_STD in tools/host_cxx.py. The
# fallback command runs in tools/, so the paths are relative to it. This
# fragment holds the shared folders most tests use. The tests with a fakes
# folder of their own get their exact list below instead, so the shared
# fakes in host_fakes/config never hide theirs.
If:
  PathMatch: tools/[^/]*\.(cpp|h)
  PathExclude:
    - tools/test_wifi_link\.cpp
    - tools/test_network_time\.cpp
    - tools/test_sd_transfer_buffer\.cpp
    - tools/test_logger_work_queue\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++23
    - -I../tools/host_fakes/config
    - -I../firmware/common/src
    - -I../firmware/common/runtime/src
    - -I../firmware/common/logger/src
    - -I../firmware/common/connectivity/src
    - -I../firmware/common/location/src
    - -I../firmware/common/gnss/src
    - -I../firmware/common/power/src
    - -I../firmware/common/sensors/src
    - -I../firmware/common/sensors/modules
    - -I../firmware/common/vendor/lz4

---
# tools/test_wifi_link.py
If:
  PathMatch: tools/test_wifi_link\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++23
    - -I../tools/wifi_host_fakes
    - -I../firmware/common/runtime/src
    - -I../firmware/common/src
    - -I../firmware/common/connectivity/src
    - -I../firmware/common/logger/src

---
# tools/test_network_time.py
If:
  PathMatch: tools/test_network_time\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++23
    - -I../tools/wifi_host_fakes
    - -I../firmware/common/connectivity/src
    - -I../firmware/common/src

---
# tools/test_sd_transfer_buffer.py
If:
  PathMatch: tools/test_sd_transfer_buffer\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++23
    - -I../tools/sd_memory_host_fakes
    - -I../firmware/common/src

---
# tools/test_logger_work_queue.py
If:
  PathMatch: tools/test_logger_work_queue\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=c++23
    - -I../tools/logger_work_host_fakes
    - -I../firmware/common/logger/src

---
# tools/test_rebuild_partial.py defines OS_FIELDS_INC per board. The editor
# reads the Waveshare field table.
If:
  PathMatch: tools/partial_rebuild_fixture\.cpp
CompileFlags:
  Add:
    - -DOS_FIELDS_INC="../firmware/esp-idf-waveshare-sim7670g/logger/telemetry_fields.inc"

---
# footer_fixture.h is included after a board telemetry_contract.h, so the
# editor reads it after the CoreS3 one.
If:
  PathMatch: tools/footer_fixture\.h
CompileFlags:
  Add:
    - -include
    - ../firmware/esp-idf-cores3/bringup/telemetry_contract.h
